# Runtime profile
# Default/current public deployment: testnet
# Hidden mainnet preview deployment: mainnet
VITE_APP_NETWORK=testnet

# Exposes the hidden/read-only mainnet preview entry point only.
# This does NOT enable real mainnet transactions.
VITE_ENABLE_MAINNET_PREVIEW=false

# Optional URL of the separate mainnet preview/production deployment.
# Keep empty on public testnet until that deployment exists.
VITE_MAINNET_APP_URL=

# Ethereum Sepolia
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Arc Testnet
VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Optional testnet EVM RPC overrides
VITE_BASE_SEPOLIA_RPC=
VITE_OPTIMISM_SEPOLIA_RPC=
VITE_ARBITRUM_SEPOLIA_RPC=

# Mainnet EVM RPC overrides
# Leave blank to use the viem-provided defaults for Ethereum/Base/OP/Arbitrum.
VITE_ETHEREUM_MAINNET_RPC=
VITE_BASE_MAINNET_RPC=
VITE_OPTIMISM_MAINNET_RPC=
VITE_ARBITRUM_MAINNET_RPC=

# Arc Public Mainnet
# Official chain identity and Circle contract addresses are pinned in source.
# These two values are optional operational endpoint overrides only.
VITE_ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
VITE_ARC_MAINNET_EXPLORER=https://explorer.arc.io

# Circle Gateway production API base.
# The app appends /v1/... paths itself.
VITE_CIRCLE_MAINNET_GATEWAY_API_BASE=https://gateway-api.circle.com

# WalletConnect (optional, recommended for mobile wallets)
VITE_WALLETCONNECT_PROJECT_ID=

# Countdown preview
# Enable only on Preview/Development deployments. Production should remain false.
VITE_COUNTDOWN_SMOKE_TEST=false

# Circle Bridge Kit (optional)
# Safe to expose in the browser only if the client SDK explicitly requires it.
VITE_CIRCLE_APP_ID=your_circle_app_id
# Do not put Circle API secrets in Vite env vars. Keep them in a backend/runtime env.
